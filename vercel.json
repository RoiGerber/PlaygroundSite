{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share/:path*",
      "destination": "https://d3twd5pvxo75es.cloudfront.net/share/:path*"
    },
    {
      "source": "/s/:path*",
      "destination": "https://gargear-api-626774022709.europe-west1.run.app/s/:path*"
    },
    {
      "source": "/video/:path*",
      "destination": "https://d3twd5pvxo75es.cloudfront.net/video/:path*"
    },
    {
      "source": "/game-profile/:path*",
      "destination": "https://d3twd5pvxo75es.cloudfront.net/game-profile/:path*"
    },
    {
      "source": "/_expo/:path*",
      "destination": "https://d3twd5pvxo75es.cloudfront.net/_expo/:path*"
    }
  ]
}
{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share/:path*",
      "destination": "https://p7knmjbkfamg7rgb5dl2nffkq0fukfq.lambda-url.us-east-1.on.aws/share/:path*"
    },
    {
      "source": "/s/:path*",
      "destination": "https://gargear-api-626774022709.europe-west1.run.app/s/:path*"
    },
    {
      "source": "/video/:path*",
      "destination": "https://d3twd5pvxo75es.cloudfront.net/video/:path*"
    }
  ]
}